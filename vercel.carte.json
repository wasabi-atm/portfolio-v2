{
  "version": 2,
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    { "source": "/", "destination": "/carte.html" },
    { "source": "/(.*)", "destination": "/carte.html" }
  ],
  "redirects": [
    { "source": "/carte.html", "destination": "/", "permanent": true },
    { "source": "/carte", "destination": "/", "permanent": true },
    { "source": "/carte/", "destination": "/", "permanent": true }
  ]
}

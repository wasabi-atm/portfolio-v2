{
  "version": 2,
  "buildCommand": "npm run build",
  "installCommand": "npm install",
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    {
      "source": "/",
      "destination": "/index.html"
    },
    {
      "source": "/blogs",
      "destination": "/blogs.html"
    },
    {
      "source": "/blog",
      "destination": "/blog/index.html"
    },
    {
      "source": "/connect",
      "destination": "/connect.html"
    },
    {
      "source": "/showcase",
      "destination": "/showcase.html"
    },
    {
      "source": "/article",
      "destination": "/article.html"
    },
    {
      "source": "/blog/:slug",
      "destination": "/article.html?slug=:slug"
    },
    {
      "source": "/showcase/:slug",
      "destination": "/project.html?slug=:slug"
    },
    {
      "source": "/blogs/article/:slug",
      "destination": "/article.html?slug=:slug"
    }
  ],
  "redirects": [
    {
      "source": "/index.html",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/blogs.html",
      "destination": "/blogs",
      "permanent": true
    },
    {
      "source": "/connect.html",
      "destination": "/connect",
      "permanent": true
    },
    {
      "source": "/showcase.html",
      "destination": "/showcase",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Permissions-Policy",
          "value": "browsing-topics=()"
        }
      ]
    }
  ]
}